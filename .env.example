# ===== Backend (proyecto Vercel "autonegocio-api") =====
# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (puerto 6543)
DATABASE_URL=postgresql://postgres.XXXX:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Supabase → Project Settings → API Keys → Secret keys (sb_secret_...) o legacy service_role
SUPABASE_URL=https://XXXX.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=fotos

# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Otro valor aleatorio distinto; Vercel Cron lo envía automáticamente
CRON_SECRET=
DEBUG=false
# URL(s) del frontend separadas por coma
CORS_ORIGINS=https://autonegocio.vercel.app

# Opcional: agentes IA
ANTHROPIC_API_KEY=
